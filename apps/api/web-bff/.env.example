# Environment variables for web-bff

# Runtime environment
APP_ENV=local
NODE_ENV=development
PORT=5010

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/piar

# Auth / JWT
# Required when the authentication module is enabled. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1h

# CORS
WEB_CLIENT_URL=http://localhost:3000
