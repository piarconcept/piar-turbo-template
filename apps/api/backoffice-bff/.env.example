# Environment variables for backoffice-bff

# Runtime environment
APP_ENV=local
NODE_ENV=development
PORT=5050

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/piar

# Auth / JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# CORS
BACKOFFICE_CLIENT_URL=http://localhost:3000,http://localhost:3001
