# ---- Apps ----
# Backoffice
BACKOFFICE_BFF_URL=http://localhost:5050
# Required. Generate independently with: openssl rand -base64 48
NEXTAUTH_SECRET=

# Web
WEB_BFF_URL=http://localhost:4000

# ---- API apps ----
# BFF ports (defaults are defined in each app config)
WEB_BFF_PORT=4000
BACKOFFICE_BFF_PORT=5050

# ---- Database ----
# Postgres connection URL used by TypeORM (BFFs)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/piar

# ---- JWT (backoffice-bff) ----
# Required. Generate independently with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1d
